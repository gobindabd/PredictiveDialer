; Replace placeholders at deploy time. Do not commit real passwords.

[bdtrunk]
type=registration
outbound_auth=bdtrunk-auth
server_uri=sip:SIP_DOMAIN_HERE
client_uri=sip:SIP_USERNAME_HERE@SIP_DOMAIN_HERE
retry_interval=60
forbidden_retry_interval=600
expiration=3600

[bdtrunk-auth]
type=auth
auth_type=userpass
username=SIP_USERNAME_HERE
password=SIP_PASSWORD_HERE

[bdtrunk]
type=aor
contact=sip:SIP_DOMAIN_HERE
qualify_frequency=60

[bdtrunk]
type=endpoint
context=from-bdtrunk
disallow=all
allow=ulaw,alaw
outbound_auth=bdtrunk-auth
aors=bdtrunk
from_domain=SIP_DOMAIN_HERE
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes
direct_media=no
